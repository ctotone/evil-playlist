{
  "id": "evil-playlist",
  "title": "Evilbram Toolbox",
  "description": "Boîte à outils transversale pour Foundry VTT : playlists, bruitages, macros MJ/joueur, visualisation des permissions et utilitaires réutilisables entre plusieurs mondes.",
  "version": "1.1.0",
  "authors": [
    {
      "name": "Evilbram"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "url": "https://github.com/ctotone/evil-playlist",
  "manifest": "https://github.com/ctotone/evil-playlist/releases/latest/download/module.json",
  "download": "https://github.com/ctotone/evil-playlist/releases/latest/download/evilbram-toolbox.zip",
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "packs": [
    {
      "name": "playlists-jdr",
      "label": "EVILBRAM - Playlists JDR",
      "path": "./packs/playlists-jdr",
      "type": "Playlist",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "soundboard-sfx",
      "label": "EVILBRAM - Bruitages & FX",
      "path": "./packs/soundboard-sfx",
      "type": "Playlist",
      "ownership": {
        "PLAYER": "NONE",
        "TRUSTED": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "macros",
      "label": "EVILBRAM - Macros",
      "path": "./packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "TRUSTED": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "EVILBRAM - Audio",
      "sorting": "a",
      "packs": [
        "playlists-jdr",
        "soundboard-sfx"
      ]
    },
    {
      "name": "EVILBRAM - Toolbox",
      "sorting": "a",
      "packs": [
        "macros"
      ]
    }
  ],
  "scripts": [
    "scripts/tools/ownership-viewer.js"
  ],
  "styles": [
    "styles/tools/ownership-viewer.css"
  ]
}
